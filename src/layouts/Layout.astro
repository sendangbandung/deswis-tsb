---
import '../styles/global.css'
import Navigation from '../components/Navigation.astro'
import { head, seo, kontak } from '../data/konfigurasi.js'
import ImagePreview from '../components/ImagePreview.astro'

interface Props {
    title?: string;
    description?: string;
    robots?: string;
}

const {
	title = head.title || "Desa Wisata Taman Sendang Bandung",
	description = head.description || "Temukan ketenangan dan keindahan alam asli di Desa Wisata Taman Sendang Bandung, Sleman, Yogyakarta.",
	robots = "index, follow"
} = Astro.props;

const canonical = new URL(Astro.url.pathname, seo.siteUrl).href;
const ogImage = new URL(seo.ogImage, seo.siteUrl).href;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "TouristAttraction",
	"name": title,
	"description": description,
	"url": canonical,
	"image": ogImage,
	"address": {
		"@type": "PostalAddress",
		"streetAddress": kontak.address,
		"addressCountry": "ID"
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": seo.geo.lat,
		"longitude": seo.geo.lng
	},
	"telephone": kontak.contact[0]?.phone || "",
	"sameAs": [kontak.instagram.link].filter(Boolean)
}
---
<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content={robots} />
		<link rel="icon" type="image/svg+xml" href="/sendangbandung.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />
		<title>{title}</title>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={head.title} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content={seo.locale} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Structured data -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">	</head>
	<body>
		<Navigation />
		<slot/>
		<ImagePreview />
	</body>
</html>
