---
import Section from './Section.astro';
import { potensi } from '../data/konfigurasi.js';
---
<Section id="wisata" className="bg-gray-50">
	<div class="w-full">
	<div class="mb-12 max-w-lg">
		<h2 class="text-2xl font-semibold text-gray-900">{potensi.title}</h2>
		<p class="mt-3 text-slate-600 leading-relaxed">
			{potensi.subtitle || "Desa di kaki Slamet — hutan pinus, sungai jernih, budaya tetap hidup. Bukan brosur, ini kenyataan."}
		</p>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
		{potensi.items.map((item) => (
			<div class="flex items-start gap-4 p-5 rounded-xl border border-gray-200 bg-white transition-shadow hover:shadow-md">
				<span class="text-3xl shrink-0 mt-0.5">{item.icon}</span>
				<div>
					<h3 class="font-semibold text-gray-900">{item.title}</h3>
					<p class="mt-1 text-sm text-slate-600 leading-relaxed">{item.description}</p>
				</div>
			</div>
		))}
	</div>
	</div>
</Section>

