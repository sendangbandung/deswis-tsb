---
import Section from './Section.astro';
import { testimoni } from '../data/konfigurasi.js';
---
<Section id="testimoni" className="bg-gray-50">
	<div class="w-full">
	<div class="mb-12">
		<h2 class="text-2xl font-semibold text-gray-900">{testimoni.title}</h2>
		<p class="mt-3 text-slate-600">
			{testimoni.subtitle}
		</p>
	</div>

	<div class="flex flex-col gap-4">
		{testimoni.items.map((testimony) => (
			<div class="flex gap-4 p-5 rounded-xl border border-gray-200 bg-white">
				<div class="shrink-0 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm">
					{testimony.name.charAt(0)}
				</div>
				<div class="flex flex-col gap-1 min-w-0">
					<div class="flex items-center gap-2">
						<span class="font-semibold text-gray-900 text-sm">{testimony.name}</span>
						<span class="text-yellow-500 text-xs">
							{Array(testimony.rating).fill('★').join('')}{Array(5 - testimony.rating).fill('☆').join('')}
						</span>
					</div>
					<p class="text-slate-600 text-sm leading-relaxed">{testimony.comment}</p>
				</div>
			</div>
		))}
	</div>
	</div>
</Section>

